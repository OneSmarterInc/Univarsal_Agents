# Placeholder values only. Generate secrets locally; never commit the real file.
AGENTS_DATABASE_URL=postgresql+psycopg://agents:REPLACE_WITH_RANDOM_PASSWORD@db/agents
AGENTS_DATA_DIR=/data
AGENTS_KEY_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AGENTS_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
AGENTS_OLLAMA_BASE_URL=http://ollama:11434
AGENTS_OLLAMA_ALLOWED_HOST=ollama
AGENTS_OLLAMA_MODEL=univarsal-qwen3-1.7b
# Exact Ollama manifest digest from /api/tags after approved import.
AGENTS_OLLAMA_DIGEST=
# SHA256 of approved original GGUF, recorded separately from Ollama manifest.
AGENTS_MODEL_ARTIFACT_SHA256=
AGENTS_GITHUB_CLIENT_ID=
AGENTS_GITHUB_CLIENT_SECRET=
AGENTS_GITHUB_REDIRECT_URI=https://api.example.com/v1/github/oauth/callback
# Compose only; no default password is accepted.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# Deployment templates only: select approved immutable image digests before use.
POSTGRES_IMAGE=
OLLAMA_IMAGE=
NGINX_IMAGE=
CADDY_IMAGE=
API_DOMAIN=

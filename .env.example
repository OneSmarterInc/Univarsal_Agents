# Univarsal Agents settings. Copy to .env and fill in. Never commit .env.
# Every setting can also be an environment variable (environment variables win).

# --- Required -----------------------------------------------------------------
# Random secret mixed into every key hash. Make one with: agents generate-secret
# Changing it later makes every existing key invalid.
AGENTS_KEY_PEPPER=REPLACE_WITH_THE_OUTPUT_OF_agents_generate-secret

# --- Database and files ---------------------------------------------------------
# Laptop: SQLite file. Server: postgresql+psycopg://user:password@host:5432/agents
AGENTS_DATABASE_URL=sqlite:///data/agents.db
AGENTS_DATA_DIR=data
# local (files under AGENTS_DATA_DIR/files) or s3
AGENTS_STORAGE=local
AGENTS_S3_BUCKET=
AGENTS_S3_PREFIX=uploads/
AGENTS_S3_REGION=
# Only for S3-compatible test servers:
AGENTS_S3_ENDPOINT_URL=

# --- Agents -----------------------------------------------------------------------
AGENTS_ENABLED_AGENTS=cv,linkedin
# LinkedIn screenshots per job (1-10)
AGENTS_LINKEDIN_MAX_FILES=5

# --- Model (default: Qwen on Ollama on this machine) ---------------------------------
# ollama / openai: any OpenAI-compatible server (Ollama, vLLM, hosted). anthropic: API key.
AGENTS_MODEL_PROVIDER=ollama
AGENTS_MODEL_BASE_URL=http://127.0.0.1:11434/v1
AGENTS_MODEL_NAME=kormic-local
AGENTS_MODEL_API_KEY=
AGENTS_MODEL_STRUCTURED_MODE=json_schema
AGENTS_MODEL_REASONING_EFFORT=none
# Must equal the model's num_ctx
AGENTS_MODEL_CONTEXT_TOKENS=16384
AGENTS_MODEL_OUTPUT_TOKENS=2048
AGENTS_MODEL_REQUEST_SECONDS=120
# Plain HTTP to a model on another machine (private networks only)
AGENTS_MODEL_ALLOW_HTTP=false
# Speed on CPU: text before the question so Ollama can reuse it (false = Kormic's earlier layout)
AGENTS_MODEL_TEXT_FIRST=true
# Per-agent model, for example {"linkedin": {"provider": "anthropic", "name": "...", "api_key": "..."}}
AGENTS_MODEL_OVERRIDES={}

# --- Reading ----------------------------------------------------------------------
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe   (Linux: leave empty)
AGENTS_TESSERACT_CMD=
# Read each file in a separate limited process (recommended)
AGENTS_ISOLATE_PARSING=true
# Longest time for one file
AGENTS_FILE_SECONDS=900
# CV text piece size (1800 = Kormic's earlier behaviour; bigger = fewer model questions)
AGENTS_CV_CHUNK_CHARS=3000

# --- Limits -----------------------------------------------------------------------
AGENTS_REQUESTS_PER_MINUTE=60
AGENTS_JOBS_PER_MINUTE=10
AGENTS_MAX_WAITING_PER_PROJECT=50
AGENTS_MAX_WAITING_TOTAL=500

# --- Job line -----------------------------------------------------------------------
AGENTS_LEASE_SECONDS=120
AGENTS_MAX_ATTEMPTS=2
AGENTS_QUEUE_EXPIRY_SECONDS=1800
AGENTS_RESULT_RETENTION_SECONDS=604800
AGENTS_POLL_SECONDS=2

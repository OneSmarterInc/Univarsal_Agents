# Settings for the Docker setup (deploy/compose.yml). Copy to deploy/.env and fill in.
# Never commit deploy/.env. On AWS, keep the secrets in SSM Parameter Store and write
# this file from there (docs/deploy-aws.md).

# --- Required secrets ----------------------------------------------------------------
# Make each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENTS_KEY_PEPPER=
POSTGRES_PASSWORD=

# --- Agents --------------------------------------------------------------------------
AGENTS_ENABLED_AGENTS=cv,linkedin,nppes,oig,sam,github
AGENTS_LINKEDIN_MAX_FILES=5

# --- Model (Ollama in the ollama service) ----------------------------------------------
# qwen3 size: 1.7b (laptop, slow and weaker), 4b (CPU server or small GPU), 8b (GPU)
MODEL_TAG=1.7b
OLLAMA_VERSION=0.6.8
AGENTS_MODEL_PROVIDER=ollama
AGENTS_MODEL_NAME=kormic-local
AGENTS_MODEL_STRUCTURED_MODE=json_schema
AGENTS_MODEL_REASONING_EFFORT=none
# Must equal num_ctx in deploy/Modelfile
AGENTS_MODEL_CONTEXT_TOKENS=16384
AGENTS_MODEL_OUTPUT_TOKENS=2048
AGENTS_MODEL_REQUEST_SECONDS=120
AGENTS_MODEL_TEXT_FIRST=true

# --- Files: local (the files volume, one server) or s3 (several servers) ----------------
AGENTS_STORAGE=local
AGENTS_S3_BUCKET=
AGENTS_S3_PREFIX=uploads/
AGENTS_S3_REGION=

# --- Lookup agents -----------------------------------------------------------------------
# SAM.gov: production needs a System Account key (a personal key allows 10 calls a day).
AGENTS_SAM_API_KEY=
AGENTS_SAM_DAILY_LIMIT=10
AGENTS_SAM_MAPPING_VERIFIED=true
# GitHub: a token with no scopes (5,000 calls an hour instead of 60).
AGENTS_GITHUB_TOKEN=
# OIG: the list is loaded by deploy/oig-refresh.sh (monthly).
AGENTS_OIG_MAX_AGE_DAYS=45

# --- Reading -----------------------------------------------------------------------------
AGENTS_ISOLATE_PARSING=true
AGENTS_FILE_SECONDS=900

# --- HTTPS with Caddy (--profile https) ------------------------------------------------
# The API's public name; its DNS A record must point at this server.
API_DOMAIN=
CADDY_VERSION=2.8.4
